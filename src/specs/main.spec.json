{
  "name": "Cockpit IDE",
  "title": "Cockpit IDE",
  "version": "0.0.20260617",
  "description": "Spatial/floating-panel IDE built in Electron. Monaco editor, xterm.js terminal, file explorer, markdown viewer, git client, and specs graph visualizer live as draggable/resizable cards on a zoomable/pannable canvas. Sessions persist to .cockpit/window.json. IDE context server exposes editor state to AI agents via WebSocket lock files.",
  "stack": {
    "runtime": "Electron 42 / Node",
    "language": "TypeScript 5.8",
    "build": {
      "main": "tsc",
      "renderer": "esbuild",
      "dev": "node dev.js"
    },
    "key_deps": {
      "Electron": "^42.1.0",
      "Monaco Editor": "^0.52.2",
      "xterm.js": "^6.0.0",
      "node-pty": "^1.1.0",
      "marked": "^18.0.3",
      "ws": "^8.21.0",
      "chokidar": "^5.0.0",
      "esbuild": "^0.28.0",
      "vitest": "^4.1.6"
    },
    "testing": "vitest + jsdom"
  },
  "architecture": {
    "process_model": "Single BrowserWindow (multi-window capable), contextIsolation enabled, preload bridge via contextBridge",
    "ipc_or_api_pattern": "Electron IPC: ipcMain.handle (request/response) + ipcRenderer.invoke (renderer→main); ipcMain.on + webContents.send (push events). MCP/IDE server: WebSocket + HTTP on 127.0.0.1 random port, JSON-RPC 2.0.",
    "state_persistence": "Workspace state serialized as JSON to .cockpit/window.json. User prefs to preferences.json in userData. Recent workspaces to recent-workspaces.json. Specs graph snapshot to .cockpit/specsmap-*.json."
  },
  "features": {
    "foundation": [
      { "id": "global-types", "name": "Global Type Declarations", "file": "global.d.ts", "spec": "global.d.spec.json" },
      { "id": "electron-main", "name": "Electron Main Process", "file": "main.ts", "spec": "electron-main.spec.json" },
      { "id": "ide-server", "name": "IDE Context Server", "file": "ide-server.ts", "spec": "ide-server.spec.json" },
      { "id": "preload", "name": "Preload Bridge", "file": "preload.ts", "spec": "preload.spec.json" },
      { "id": "specgen-hash", "name": "Specgen Hash", "file": "specgen-hash.ts", "spec": "specgen-hash.spec.json" }
    ],
    "core": [
      { "id": "theme", "name": "Theme", "file": "theme.ts", "spec": "theme.spec.json" },
      { "id": "index", "name": "Renderer Entry", "file": "index.ts", "spec": "index.spec.json" },
      { "id": "app", "name": "App Orchestrator", "file": "App.ts", "spec": "app.spec.json" },
      { "id": "canvas-area", "name": "Canvas Area", "file": "CanvasArea.ts", "spec": "canvas-area.spec.json" },
      { "id": "top-bar", "name": "Top Bar", "file": "TopBar.ts", "spec": "top-bar.spec.json" }
    ],
    "widget": [
      { "id": "canvas-grid", "name": "Canvas Grid", "file": "canvas-grid.ts", "spec": "canvas-grid.spec.json" },
      { "id": "canvas-statusbar", "name": "Canvas Statusbar", "file": "canvas-statusbar.ts", "spec": "canvas-statusbar.spec.json" },
      { "id": "plugin-card", "name": "Plugin Card", "file": "PluginCard.ts", "spec": "plugin-card.spec.json", "ui": "plugin-card-ui.spec.json" }
    ],
    "modal": [
      { "id": "about-modal", "name": "About Modal", "file": "AboutModal.ts", "spec": "about-modal.spec.json", "ui": "about-modal-ui.spec.json" },
      { "id": "confirm-modal", "name": "Confirm Modal", "file": "ConfirmModal.ts", "spec": "confirm-modal.spec.json", "ui": "confirm-modal-ui.spec.json" },
      { "id": "theme-modal", "name": "Theme Modal", "file": "ThemeModal.ts", "spec": "theme-modal.spec.json", "ui": "theme-modal-ui.spec.json" },
      { "id": "welcome-modal", "name": "Welcome Modal", "file": "WelcomeModal.ts", "spec": "welcome-modal.spec.json", "ui": "welcome-modal-ui.spec.json" }
    ],
    "overlay": [
      { "id": "command-palette", "name": "Command Palette", "file": "CommandPalette.ts", "spec": "command-palette.spec.json", "ui": "command-palette-ui.spec.json" },
      { "id": "context-menu", "name": "Context Menu", "file": "ContextMenu.ts", "spec": "context-menu.spec.json", "ui": "context-menu-ui.spec.json" },
      { "id": "tutorial", "name": "Tutorial", "file": "Tutorial.ts", "spec": "tutorial.spec.json" }
    ],
    "plugin": [
      { "id": "terminal-plugin", "name": "Terminal Plugin", "file": "TerminalPlugin.ts", "spec": "terminal-plugin.spec.json" },
      { "id": "monaco-editor-plugin", "name": "Monaco Editor Plugin", "file": "MonacoEditorPlugin.ts", "spec": "monaco-editor-plugin.spec.json" },
      { "id": "file-explorer-plugin", "name": "File Explorer Plugin", "file": "FileExplorerPlugin.ts", "spec": "file-explorer-plugin.spec.json" },
      { "id": "explorer-plugin", "name": "Explorer Plugin", "file": "ExplorerPlugin.ts", "spec": "explorer-plugin.spec.json" },
      { "id": "markdown-plugin", "name": "Markdown Plugin", "file": "MarkdownPlugin.ts", "spec": "markdown-plugin.spec.json" },
      { "id": "git-plugin", "name": "Git Plugin", "file": "GitPlugin.ts", "spec": "git-plugin.spec.json" },
      { "id": "specs-map-plugin", "name": "Specs Map Plugin", "file": "SpecsMapPlugin.ts", "spec": "specs-map-plugin.spec.json" }
    ],
    "entry": [
      { "id": "package", "name": "Package Manifest", "entry": "package.json", "spec": "package.spec.json" },
      { "id": "makefile", "name": "Makefile", "entry": "Makefile", "spec": "makefile.spec.json" }
    ]
  },
  "dependency_graph": {
    "description": "Internal project import edges",
    "edges": {
      "global.d.ts": [],
      "main.ts": ["ide-server.ts"],
      "ide-server.ts": [],
      "preload.ts": [],
      "specgen-hash.ts": [],
      "theme.ts": [],
      "index.ts": ["App.ts"],
      "App.ts": ["TopBar.ts", "CanvasArea.ts", "WelcomeModal.ts", "AboutModal.ts", "ThemeModal.ts", "Tutorial.ts", "theme.ts"],
      "CanvasArea.ts": ["canvas-grid.ts", "canvas-statusbar.ts", "PluginCard.ts", "TerminalPlugin.ts", "MonacoEditorPlugin.ts", "ExplorerPlugin.ts", "GitPlugin.ts", "ContextMenu.ts", "MarkdownPlugin.ts", "SpecsMapPlugin.ts"],
      "TopBar.ts": ["theme.ts"],
      "PluginCard.ts": [],
      "canvas-grid.ts": [],
      "canvas-statusbar.ts": [],
      "AboutModal.ts": [],
      "ConfirmModal.ts": [],
      "ThemeModal.ts": ["theme.ts"],
      "WelcomeModal.ts": [],
      "CommandPalette.ts": [],
      "ContextMenu.ts": [],
      "Tutorial.ts": [],
      "TerminalPlugin.ts": [],
      "MonacoEditorPlugin.ts": ["ContextMenu.ts", "theme.ts"],
      "FileExplorerPlugin.ts": ["ContextMenu.ts", "ConfirmModal.ts"],
      "ExplorerPlugin.ts": ["FileExplorerPlugin.ts", "MonacoEditorPlugin.ts", "CommandPalette.ts"],
      "MarkdownPlugin.ts": ["ContextMenu.ts"],
      "GitPlugin.ts": [],
      "SpecsMapPlugin.ts": ["specgen-hash.ts", "SPECGEN.md"]
    }
  },
  "ipc_channels": {
    "window": ["window:new", "window:minimize", "window:maximize", "window:close", "window:isMaximized"],
    "clipboard": ["clipboard:readText", "clipboard:writeText"],
    "terminal": ["terminal:create", "terminal:write", "terminal:resize", "terminal:kill", "terminal:data", "terminal:exit"],
    "workspace": ["workspace:select", "workspace:setPath", "workspace:getPath", "workspace:load", "workspace:save", "workspace:getRecent", "workspace:addRecent", "workspace:removeRecent"],
    "fs": ["fs:readDir", "fs:readFile", "fs:writeFile", "fs:mkdir", "fs:delete", "fs:copy", "fs:rename"],
    "file": ["file:watch", "file:unwatch", "file:changed"],
    "shell": ["shell:openExternal"],
    "prefs": ["prefs:load", "prefs:save"],
    "git": ["git:remotes", "git:branches", "git:checkout", "git:log", "git:showTree", "git:diff", "git:currentBranch", "git:stagedFiles", "git:unstagedFiles", "git:stagedDiff", "git:unstagedDiff", "git:commitBody", "git:stage", "git:unstage", "git:commit", "git:push", "git:checkAhead"],
    "ide": ["ide:editorState", "ide:status"],
    "app": ["app:version"]
  },
  "keyboard_shortcuts": [
    { "key": "Ctrl+Shift+N", "scope": "app", "action": "New window" },
    { "key": "Ctrl+W", "scope": "editor", "action": "Close active editor tab" },
    { "key": "Ctrl+Tab", "scope": "canvas", "action": "Cycle cards forward" },
    { "key": "Ctrl+Shift+Tab", "scope": "canvas", "action": "Cycle cards backward" },
    { "key": "Ctrl+P", "scope": "canvas", "action": "Open file search palette" },
    { "key": "Ctrl+J", "scope": "canvas", "action": "New terminal" },
    { "key": "Ctrl+S", "scope": "editor", "action": "Save current file" },
    { "key": "Ctrl+= / Ctrl+- / Ctrl+0", "scope": "app", "action": "Renderer zoom in/out/reset" },
    { "key": "Escape", "scope": "modal", "action": "Close modal/overlay" },
    { "key": "Ctrl+F", "scope": "specsmap", "action": "Search nodes in SpecsMap" }
  ],
  "test_coverage": {
    "total_test_files": 25,
    "total_tests": "968",
    "run_time": "~10s",
    "framework": "vitest + jsdom",
    "specs_with_direct_tests": 20,
    "specs_with_indirect_tests": 5,
    "specs_without_tests": 4
  }
}
