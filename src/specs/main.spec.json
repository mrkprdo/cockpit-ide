{
  "name": "Cockpit IDE",
  "version": "0.0.1",
  "description": "Spatial/floating-panel IDE built on Electron. Monaco editor, xterm.js terminal, file explorer, and markdown viewer live as draggable/resizable cards on a zoomable/pannable canvas. Sessions persist to .cockpit/window.json.",
  "stack": {
    "runtime": "Electron 42",
    "language": "TypeScript 5.8",
    "build": {
      "main": "tsc",
      "preload": "tsc",
      "renderer": "esbuild 0.28",
      "dev": "dev.js (tsc + esbuild + respawn)"
    },
    "key_deps": {
      "editor": "Monaco Editor 0.53 (AMD-loaded)",
      "terminal": "@xterm/xterm 6 + node-pty 1",
      "canvas_text": "@chenglou/pretext",
      "markdown": "marked 18",
      "bundler": "esbuild 0.28",
      "packaging": "electron-packager + NSIS"
    },
    "testing": "vitest 4 with jsdom"
  },
  "architecture": {
    "process_model": "3-process Electron (main/Node → preload/bridge → renderer/Chromium). Main handles filesystem, PTY terminals, window management, and git CLI. Preload exposes contextBridge API. Renderer runs all UI components (canvas, editor, terminal, modals). Optional IDE context server runs alongside main process.",
    "ipc_or_api_pattern": "ipcRenderer.invoke / ipcMain.handle (async request/response) for most operations. ipcRenderer.send / webContents.send (push) for terminal:data, terminal:exit, fs:onChanged. contextBridge.exposeInMainWorld exposes all channels as window.electronAPI namespaces.",
    "state_persistence": "Canvas state (card positions, sizes, plugin configs) serialized as EditorState[] to .cockpit/window.json via workspace:save/load IPC. Auto-saves on state change (debounced 500ms). Recent workspaces in recent-workspaces.json. Last workspace in last-workspace.txt.",
    "concurrency_model": "Single-threaded async I/O per process. node-pty spawns child processes per terminal session. chokidar file watcher (debounced 100ms) emits change events via IPC push."
  },
  "features": {
    "foundation": [
      { "id": "global-d", "name": "Global Type Declarations", "file": "src/global.d.ts", "spec": "global.d.spec.json" },
      { "id": "electron-main", "name": "Electron Main Process", "file": "src/main/main.ts", "spec": "electron-main.spec.json" },
      { "id": "ide-server", "name": "IDE Context Server", "file": "src/main/ide-server.ts", "spec": "ide-server.spec.json" },
      { "id": "preload", "name": "Preload Bridge", "file": "src/preload/preload.ts", "spec": "preload.spec.json" },
      { "id": "index", "name": "Renderer Entry", "file": "src/renderer/index.ts", "spec": "index.spec.json" },
      { "id": "specgen-hash", "name": "Specgen Hash Auto-Generated", "file": "src/renderer/specgen-hash.ts", "spec": "specgen-hash.spec.json" }
    ],
    "core": [
      { "id": "theme", "name": "Theme System", "file": "src/renderer/theme.ts", "spec": "theme.spec.json" },
      { "id": "app", "name": "App Orchestrator", "file": "src/renderer/components/App.ts", "spec": "app.spec.json" },
      { "id": "canvas-area", "name": "Canvas Area Engine", "file": "src/renderer/components/CanvasArea.ts", "spec": "canvas-area.spec.json" },
      { "id": "plugin-card", "name": "Plugin Card Widget", "file": "src/renderer/components/PluginCard.ts", "spec": "plugin-card.spec.json", "ui": "plugin-card-ui.spec.json" },
      { "id": "topbar", "name": "Top Bar Menu", "file": "src/renderer/components/TopBar.ts", "spec": "topbar.spec.json" },
      { "id": "canvas-statusbar", "name": "Canvas Status Bar", "file": "src/renderer/components/canvas-statusbar.ts", "spec": "canvas-statusbar.spec.json" },
      { "id": "welcome-modal", "name": "Welcome Modal", "file": "src/renderer/components/WelcomeModal.ts", "spec": "welcome-modal.spec.json", "ui": "welcome-modal-ui.spec.json" },
      { "id": "about-modal", "name": "About Modal", "file": "src/renderer/components/AboutModal.ts", "spec": "about-modal.spec.json", "ui": "about-modal-ui.spec.json" },
      { "id": "confirm-modal", "name": "Confirm Modal", "file": "src/renderer/components/ConfirmModal.ts", "spec": "confirm-modal.spec.json", "ui": "confirm-modal-ui.spec.json" },
      { "id": "context-menu", "name": "Context Menu", "file": "src/renderer/components/ContextMenu.ts", "spec": "context-menu.spec.json", "ui": "context-menu-ui.spec.json" },
      { "id": "tutorial", "name": "Tutorial Overlay", "file": "src/renderer/components/Tutorial.ts", "spec": "tutorial.spec.json" },
      { "id": "theme-modal", "name": "Theme Modal", "file": "src/renderer/components/ThemeModal.ts", "spec": "theme-modal.spec.json", "ui": "theme-modal-ui.spec.json" }
    ],
    "plugin": [
      { "id": "terminal-plugin", "name": "Terminal Plugin", "file": "src/renderer/components/TerminalPlugin.ts", "spec": "terminal-plugin.spec.json" },
      { "id": "monaco-editor-plugin", "name": "Monaco Editor Plugin", "file": "src/renderer/components/MonacoEditorPlugin.ts", "spec": "monaco-editor-plugin.spec.json" },
      { "id": "file-explorer-plugin", "name": "File Explorer Plugin", "file": "src/renderer/components/FileExplorerPlugin.ts", "spec": "file-explorer-plugin.spec.json" },
      { "id": "explorer-plugin", "name": "Explorer Split-Pane Plugin", "file": "src/renderer/components/ExplorerPlugin.ts", "spec": "explorer-plugin.spec.json" },
      { "id": "markdown-plugin", "name": "Markdown Plugin", "file": "src/renderer/components/MarkdownPlugin.ts", "spec": "markdown-plugin.spec.json" },
      { "id": "git-plugin", "name": "Git Plugin", "file": "src/renderer/components/GitPlugin.ts", "spec": "git-plugin.spec.json" },
      { "id": "specsmap-plugin", "name": "SpecsMap Plugin", "file": "src/renderer/components/SpecsMapPlugin.ts", "spec": "specsmap-plugin.spec.json" },
      { "id": "command-palette", "name": "Command Palette", "file": "src/renderer/components/CommandPalette.ts", "spec": "command-palette.spec.json", "ui": "command-palette-ui.spec.json" }
    ],
    "utility": [
      { "id": "text-renderer", "name": "Canvas Text Renderer", "file": "src/renderer/components/TextRenderer.ts", "spec": "text-renderer.spec.json" },
      { "id": "canvas-grid", "name": "Canvas Grid Utility", "file": "src/renderer/components/canvas-grid.ts", "spec": "canvas-grid.spec.json" }
    ]
  },
  "dependency_graph": {
    "description": "Edges represent internal imports between source files. Foundation layer imports nothing. Core imports foundation. Plugins import core utilities. Direction: file → [its dependencies].",
    "edges": {
      "src/global.d.ts": [],
      "src/main/main.ts": [],
      "src/main/ide-server.ts": ["src/main/main.ts"],
      "src/preload/preload.ts": [],
      "src/renderer/index.ts": ["src/renderer/components/App.ts"],
      "src/renderer/theme.ts": [],
      "src/renderer/specgen-hash.ts": [],
      "src/renderer/components/App.ts": ["src/renderer/components/CanvasArea.ts", "src/renderer/components/TopBar.ts", "src/renderer/components/WelcomeModal.ts", "src/renderer/theme.ts"],
      "src/renderer/components/CanvasArea.ts": ["src/renderer/components/PluginCard.ts", "src/renderer/components/canvas-grid.ts", "src/renderer/components/canvas-statusbar.ts", "src/renderer/components/TerminalPlugin.ts", "src/renderer/components/ExplorerPlugin.ts", "src/renderer/components/MarkdownPlugin.ts", "src/renderer/components/GitPlugin.ts", "src/renderer/components/SpecsMapPlugin.ts"],
      "src/renderer/components/PluginCard.ts": ["src/renderer/components/TextRenderer.ts"],
      "src/renderer/components/TopBar.ts": [],
      "src/renderer/components/canvas-grid.ts": [],
      "src/renderer/components/canvas-statusbar.ts": [],
      "src/renderer/components/TextRenderer.ts": [],
      "src/renderer/components/TerminalPlugin.ts": [],
      "src/renderer/components/MonacoEditorPlugin.ts": [],
      "src/renderer/components/FileExplorerPlugin.ts": ["src/renderer/components/ConfirmModal.ts"],
      "src/renderer/components/ExplorerPlugin.ts": ["src/renderer/components/FileExplorerPlugin.ts", "src/renderer/components/MonacoEditorPlugin.ts"],
      "src/renderer/components/MarkdownPlugin.ts": [],
      "src/renderer/components/GitPlugin.ts": [],
      "src/renderer/components/SpecsMapPlugin.ts": [],
      "src/renderer/components/WelcomeModal.ts": [],
      "src/renderer/components/AboutModal.ts": [],
      "src/renderer/components/ConfirmModal.ts": [],
      "src/renderer/components/ContextMenu.ts": [],
      "src/renderer/components/CommandPalette.ts": [],
      "src/renderer/components/Tutorial.ts": [],
      "src/renderer/components/ThemeModal.ts": ["src/renderer/theme.ts"]
    }
  },
  "ipc_channels": {
    "app": ["app:getVersion"],
    "window": ["window:new", "window:minimize", "window:maximize", "window:close", "window:isMaximized"],
    "clipboard": ["clipboard:readText", "clipboard:writeText"],
    "terminal": ["terminal:create", "terminal:write", "terminal:resize", "terminal:kill", "terminal:data", "terminal:exit"],
    "workspace": ["workspace:select", "workspace:setPath", "workspace:getPath", "workspace:load", "workspace:save", "workspace:recentWorkspaces"],
    "fs": ["fs:readDir", "fs:readFile", "fs:writeFile", "fs:mkdir", "fs:delete", "fs:rename", "fs:exists", "fs:stat", "fs:copy", "fs:onChanged", "fs:onSelected"],
    "shell": ["shell:openPath", "shell:openExternal"],
    "dialog": ["dialog:openFile", "dialog:saveFile", "dialog:selectDirectory"],
    "git": ["git:log", "git:branches", "git:remotes", "git:diff", "git:stage", "git:unstage", "git:commit", "git:push", "git:pull", "git:status", "git:stash"],
    "specsmap": ["specsmap:getSpecData"],
    "prefs": ["prefs:load", "prefs:save"],
    "ide-server": ["ide-server:state"]
  },
  "keyboard_shortcuts": [
    { "key": "Ctrl+Shift+N", "scope": "app", "action": "Create new Electron window" },
    { "key": "Ctrl+W", "scope": "app", "action": "Prevented (window close guard)" },
    { "key": "Ctrl+Tab", "scope": "app", "action": "Cycle focus through open plugin cards" },
    { "key": "Ctrl+P", "scope": "app", "action": "Open Command Palette file finder" },
    { "key": "Ctrl+S", "scope": "editor", "action": "Save currently active editor tab" },
    { "key": "Ctrl+V", "scope": "terminal", "action": "Paste clipboard content into terminal" },
    { "key": "Ctrl+Shift+V", "scope": "terminal", "action": "Paste clipboard content into terminal (alt)" }
  ],
  "api_endpoints": [],
  "test_coverage": {
    "total_test_files": 20,
    "total_tests": "755+",
    "run_time": "~10s",
    "framework": "vitest 4 with jsdom + @testing-library/dom",
    "specs_with_direct_tests": 17,
    "specs_with_indirect_tests": 8,
    "specs_without_tests": 3
  }
}
