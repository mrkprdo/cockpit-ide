{
  "name": "Package Manifest",
  "entry": "package.json",
  "description": "NPM package manifest for Cockpit IDE v0.0.20260617. Declares Electron 42 runtime, TypeScript 5.8 toolchain, esbuild renderer bundler, and vitest test framework.",
  "type": "entry",
  "layer": "foundation",
  "singleton": true,
  "exports": [],
  "dependencies": [],
  "referenced_by": [],
  "scripts": {
    "build": "tsc + esbuild renderer bundle + asset copy",
    "dev": "Development mode with watch",
    "prod": "Production build",
    "pack": "Electron packager + NSIS installer",
    "clean": "Remove dist/, release/, out/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "build": {
    "main": "tsc -p tsconfig.main.json",
    "renderer": "esbuild --bundle --format=iife"
  },
  "external_deps": {
    "electron": "^42.1.0",
    "monaco-editor": "^0.52.2",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "marked": "^18.0.3",
    "ws": "^8.21.0",
    "chokidar": "^5.0.0",
    "typescript": "^5.8.0",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.6"
  },
  "interface": {},
  "lifecycle": {
    "created_by": "Node.js package resolution",
    "destroyed_by": "N/A",
    "singleton": true
  }
}
