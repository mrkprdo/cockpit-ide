{
  "name": "cockpit-ide",
  "version": "1.0.0",
  "description": "Cockpit IDE — Art Nouveau × Floating",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && esbuild src/renderer/index.ts --bundle --outfile=dist/renderer/index.js --format=iife && copy src\\renderer\\*.html dist\\renderer\\ && copy src\\renderer\\*.css dist\\renderer\\",
    "start": "npm run build && electron .",
    "dev": "electron . --dev",
    "prod": "electron .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0",
    "wait-on": "^8.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
